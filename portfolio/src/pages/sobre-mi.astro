---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

// Puedes colocar una foto de perfil profesional en src/assets/retrato.jpg
import retrato from '../assets/pogacar.webp'; 
---

<Layout title="Sobre mí | Marta Arquitectura">
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-24">
    
    <!-- Encabezado de sección -->
    <div class="mb-16 pb-6 border-b border-zinc-200">
      <span class="text-xs font-mono uppercase text-zinc-400 tracking-widest">Biografía y Trayectoria</span>
      <h1 class="text-4xl font-light text-zinc-900 mt-2">Sobre mí</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      
      <!-- Columna Izquierda: Retrato y Descarga de CV (4 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div class="aspect-[3/4] bg-zinc-100 overflow-hidden relative border border-zinc-200">
          <Image 
            src={retrato} 
            alt="Marta - Arquitecta" 
            class="w-full h-full object-cover filter grayscale hover:grayscale-0 transition-all duration-700"
          />
        </div>

        <!-- Botón para descargar CV en PDF -->
        <a 
          href="/cv-marta-arquitectura.pdf" 
          target="_blank" 
          download 
          class="flex items-center justify-between w-full px-6 py-4 bg-zinc-900 text-white text-xs font-mono uppercase tracking-wider hover:bg-zinc-800 transition-colors group"
        >
          <span>Descargar Currículum (PDF)</span>
          <span class="group-hover:translate-x-1 transition-transform">↓</span>
        </a>
      </div>

      <!-- Columna Derecha: Bio, Filosofía y Capacidades Técnicas (7 cols) -->
      <div class="lg:col-span-7 space-y-12 text-zinc-700 leading-relaxed">
        
        <!-- Bio / Declaración de intenciones -->
        <div class="space-y-4">
          <h2 class="text-2xl font-light text-zinc-900">Enfoque Arquitectónico</h2>
          <p class="text-lg font-light text-zinc-600 leading-relaxed">
            Arquitecta colegiada con especial interés en la integración paisajística, la eficiencia energética y el detalle constructivo de alta precisión.
          </p>
          <p class="text-sm text-zinc-600">
            A lo largo de mi trayectoria he combinado la práctica independiente en proyectos residenciales propios con la colaboración en estudios consolidados desarrollando proyectos de escala dotacional y terciaria. Mi metodología abarca desde las primeras fases conceptuales y concursos hasta la coordinación BIM y la dirección de obra.
          </p>
        </div>

        <!-- Software y Herramientas -->
        <div class="pt-8 border-t border-zinc-200">
          <h3 class="text-xs font-mono uppercase text-zinc-400 tracking-widest mb-6">Software & Herramientas Técnicas</h3>
          
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 text-sm font-mono">
            <div>
              <span class="text-zinc-900 font-medium block">Modelado & BIM</span>
              <p class="text-xs text-zinc-500 mt-1">Revit, ArchiCAD, Rhino, AutoCAD</p>
            </div>
            <div>
              <span class="text-zinc-900 font-medium block">Visualización</span>
              <p class="text-xs text-zinc-500 mt-1">V-Ray, Lumion, Enscape, Photoshop</p>
            </div>
            <div>
              <span class="text-zinc-900 font-medium block">Gestión & Eficiencia</span>
              <p class="text-xs text-zinc-500 mt-1">Presto, CYPE, Medidas Sostenibles</p>
            </div>
          </div>
        </div>

        <!-- Experiencia / Colaboraciones Destacadas -->
        <div class="pt-8 border-t border-zinc-200">
          <h3 class="text-xs font-mono uppercase text-zinc-400 tracking-widest mb-6">Trayectoria & Estudios</h3>
          
          <div class="space-y-6 text-sm">
            <div class="flex justify-between items-baseline border-b border-zinc-100 pb-3">
              <div>
                <p class="font-medium text-zinc-900">Estudio de Arquitectura R&A</p>
                <p class="text-xs text-zinc-500">Arquitecta de Proyecto / Coordinación BIM</p>
              </div>
              <span class="text-xs font-mono text-zinc-400">2022 — Presente</span>
            </div>

            <div class="flex justify-between items-baseline border-b border-zinc-100 pb-3">
              <div>
                <p class="font-medium text-zinc-900">Estudio García & Asociados</p>
                <p class="text-xs text-zinc-500">Desarrollo de Fachadas y Concursos</p>
              </div>
              <span class="text-xs font-mono text-zinc-400">2020 — 2022</span>
            </div>

            <div class="flex justify-between items-baseline border-b border-zinc-100 pb-3">
              <div>
                <p class="font-medium text-zinc-900">Máster Universitario en Arquitectura</p>
                <p class="text-xs text-zinc-500">Escuela Técnica Superior de Arquitectura (ETSAM)</p>
              </div>
              <span class="text-xs font-mono text-zinc-400">2019</span>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
</Layout>yyyyy