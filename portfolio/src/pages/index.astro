---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// Obtenemos solo los proyectos marcados como destacados y los ordenamos
const featuredProjects = await getCollection('projects', ({ data }) => data.featured);
featuredProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Marta | Portfolio de Arquitectura">
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-6 pt-24 pb-16 md:pt-32 md:pb-24">
    <span class="text-xs font-mono uppercase text-zinc-400 tracking-widest">Portfolio de Arquitectura</span>
    <h1 class="text-4xl sm:text-6xl font-light text-zinc-900 mt-4 max-w-4xl leading-tight">
      Exploración espacial entre la <span class="italic font-normal">obra personal</span> y la escala colaborativa.
    </h1>
  </section>

  <!-- Retícula de Proyectos Destacados -->
  <section id="proyectos" class="max-w-7xl mx-auto px-6 py-12">
    <div class="flex justify-between items-end mb-12 border-b border-zinc-200 pb-4">
      <h2 class="text-xl font-light text-zinc-900">Proyectos Seleccionados</h2>
      <span class="text-xs text-zinc-400 font-mono">({featuredProjects.length})</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16">
      {featuredProjects.map((project) => (
        <a href={`/proyectos/${project.id}`} class="group block">
          <article>
            <div class="overflow-hidden bg-zinc-100 aspect-[4/3] mb-5 relative">
              <Image 
                src={project.data.coverImage} 
                alt={project.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <span class={`absolute top-4 left-4 text-[10px] uppercase font-mono tracking-wider px-3 py-1 backdrop-blur-md ${
                project.data.type === 'personal' 
                  ? 'bg-zinc-900/80 text-white' 
                  : 'bg-white/80 text-zinc-900 border border-zinc-200'
              }`}>
                {project.data.type === 'personal' ? 'Proyecto Personal' : 'Colaboración'}
              </span>
            </div>

            <div class="flex justify-between items-start">
              <div>
                <h3 class="text-xl font-medium text-zinc-900 group-hover:underline underline-offset-4">
                  {project.data.title}
                </h3>
                <p class="text-sm text-zinc-500 mt-1">{project.data.tagline}</p>
                {project.data.collaboration && (
                  <p class="text-xs text-zinc-400 font-mono mt-2">
                    w/ {project.data.collaboration.studio} · {project.data.collaboration.role}
                  </p>
                )}
              </div>
              <span class="text-xs font-mono text-zinc-400">{project.data.year}</span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>
</Layout>